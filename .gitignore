# Secrets — never commit
.env
.env.*
!.env.example

# Virtualenvs
.venv/
venv/

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/

# Generated databases
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# Local data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
~$*
