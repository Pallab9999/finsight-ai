# --- LLM provider (optional) -------------------------------------------------
# The executive summary is the only LLM-generated field. All scores are
# deterministic, so the demo works with no provider configured at all.
# Providers are tried in order: Bedrock, then Gemini, then a local template.

# Option A: Amazon Bedrock.
# Paste a Bedrock API key here (the "bedrock-api-key-..." string). boto3 reads
# this variable directly. Never commit a real value.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# Option A (alternative): standard AWS credentials instead of a Bedrock API key.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Option B: Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- App ---------------------------------------------------------------------
API_URL=http://localhost:8000
BANKBENCH_SQLITE_PATH=bankbench-data-sync/data/bankbench_data_sync.db
